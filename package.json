{
  "name": "receptenmap",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-receptenmap --only firestore \"node --test tests/firestore/*.test.js\"",
    "check:functions": "wrangler pages functions build functions --outdir .wrangler/functions-check --compatibility-date 2026-11-11",
    "dev:pages": "wrangler pages dev dist --compatibility-date 2026-11-11"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "jose": "^6.2.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-tools": "^14.27.0",
    "vite": "^6.4.1",
    "wrangler": "^4.160.1"
  }
}
